<Window xmlns:a="clr-namespace:AutoRejoinApp;assembly=AutoRejoin" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoRejoin — by clxwnlesss" Width="1160" Height="770" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="46" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <!-- AutoRejoin 3.0 «Neon» · владелец clxwnlesss -->
    <Border x:Name="Root" BorderThickness="1" Background="{StaticResource Bg}" BorderBrush="{StaticResource RootBorder}"
            RenderTransformOrigin="0.5,0.5" Opacity="0">
        
        <Border.RenderTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="0.985" ScaleY="0.985"/>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35"/>
                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource EaseOut}"/>
                        <DoubleAnimation Storyboard.TargetName="RootScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource EaseOut}"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <Grid ClipToBounds="True">
            <!-- живой неоновый фон: клетка и три плывущих пятна света -->
            <Border Background="{StaticResource GridBrush}" IsHitTestVisible="False"/>
            <Canvas IsHitTestVisible="False" Visibility="{StaticResource FxVisibility}">
                <Ellipse Width="620" Height="620" Canvas.Left="-160" Canvas.Top="-240" Opacity="0.55">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#55A855F7" Offset="0"/>
                            <GradientStop Color="#00A855F7" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Orb1"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="560" Height="560" Canvas.Left="760" Canvas.Top="380" Opacity="0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#4422D3EE" Offset="0"/>
                            <GradientStop Color="#0022D3EE" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Orb2"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="420" Height="420" Canvas.Left="520" Canvas.Top="-180" Opacity="0.4">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#44E879F9" Offset="0"/>
                            <GradientStop Color="#00E879F9" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.RenderTransform>
                        <TranslateTransform x:Name="Orb3"/>
                    </Ellipse.RenderTransform>
                </Ellipse>
                <Canvas.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="Orb1" Storyboard.TargetProperty="X" From="0" To="220" Duration="0:0:17"/>
                                <DoubleAnimation Storyboard.TargetName="Orb1" Storyboard.TargetProperty="Y" From="0" To="160" Duration="0:0:13"/>
                                <DoubleAnimation Storyboard.TargetName="Orb2" Storyboard.TargetProperty="X" From="0" To="-260" Duration="0:0:19"/>
                                <DoubleAnimation Storyboard.TargetName="Orb2" Storyboard.TargetProperty="Y" From="0" To="-140" Duration="0:0:15"/>
                                <DoubleAnimation Storyboard.TargetName="Orb3" Storyboard.TargetProperty="X" From="0" To="-180" Duration="0:0:21"/>
                                <DoubleAnimation Storyboard.TargetName="Orb3" Storyboard.TargetProperty="Y" From="0" To="220" Duration="0:0:16"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Canvas.Triggers>
            </Canvas>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== Боковая панель ===== -->
                <Grid>
                <Border Background="{StaticResource SidebarBg}"/>
                <!-- неоновая кромка панели -->
                <Border Width="1.5" HorizontalAlignment="Right" Background="{StaticResource NeonLine}" Effect="{StaticResource GlowSoft}"/>
                <Border BorderThickness="0">
                    <DockPanel>
                        <!-- логотип: неоновый шестиугольник со стрелкой перезахода -->
                        <Grid DockPanel.Dock="Top" Margin="20,20,16,26">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="46" Height="46" Background="Transparent">
                                    <Path Data="M23,2 L42,12.5 L42,33.5 L23,44 L4,33.5 L4,12.5 Z" Fill="{StaticResource LogoFill}" StrokeThickness="2.2"
                                          Stroke="{StaticResource BrandGradient}" Effect="{StaticResource GlowAccent}"/>
                                    <a:Ico Glyph="rejoin" Size="21" Thickness="2.4" Foreground="{StaticResource BrandText}" RenderTransformOrigin="0.5,0.5">
                                        <a:Ico.RenderTransform>
                                            <RotateTransform x:Name="LogoSpin" Angle="0"/>
                                        </a:Ico.RenderTransform>
                                    </a:Ico>
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="LogoSpin" Storyboard.TargetProperty="Angle" From="-270" To="0" Duration="0:0:1.1">
                                                        <DoubleAnimation.EasingFunction>
                                                            <ElasticEase EasingMode="EaseOut" Oscillations="1" Springiness="5"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="UIElement.MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="LogoSpin" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.8" EasingFunction="{StaticResource EaseOut}"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                </Grid>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="AUTOREJOIN" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrandText}" Effect="{StaticResource GlowSoft}"/>
                                        <Border CornerRadius="5" BorderBrush="{StaticResource BadgeBorder}" BorderThickness="1" Background="{StaticResource BadgeBg}" Padding="5,0,5,1" Margin="7,1,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="VersionText" Text="3.0" Foreground="{StaticResource AccentText}" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="by clxwnlesss" Foreground="{StaticResource LabelBrush}" FontSize="11.5" FontWeight="SemiBold" Margin="1,1,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- связь -->
                        <Button x:Name="ContactButton" DockPanel.Dock="Bottom" Style="{StaticResource BtnDiscord}" Margin="14,0,14,16" Padding="12,10"
                                ToolTip="Discord: clxwnlesss — открыть профиль (ник скопируется)">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <a:Ico Glyph="&#xE8BD;" Size="16"/>
                                <TextBlock Text="Связь в Discord" Margin="9,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- состояние движка -->
                        <Border DockPanel.Dock="Bottom" Margin="14,0,14,12" Padding="16,14" CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource EngineCardBorder}" Background="{StaticResource EngineCardBg}">
                            
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="12" Height="12" VerticalAlignment="Center">
                                        <Ellipse x:Name="EngineGlow" Width="12" Height="12" Fill="{StaticResource Text3}" Opacity="0.35" RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <ScaleTransform x:Name="GlowScale"/>
                                            </Ellipse.RenderTransform>
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard RepeatBehavior="Forever">
                                                            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleX" From="0.8" To="1.9" Duration="0:0:1.6" EasingFunction="{StaticResource EaseOut}"/>
                                                            <DoubleAnimation Storyboard.TargetName="GlowScale" Storyboard.TargetProperty="ScaleY" From="0.8" To="1.9" Duration="0:0:1.6" EasingFunction="{StaticResource EaseOut}"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                        <Ellipse x:Name="EngineDot" Width="7" Height="7" Fill="{StaticResource Text3}"/>
                                    </Grid>
                                    <TextBlock x:Name="EngineTitle" Text="Остановлен" Margin="10,0,0,0" FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="16"/>
                                </StackPanel>
                                <TextBlock x:Name="EngineSub" Text="" Foreground="{StaticResource Text2}" FontSize="12"
                                           Margin="0,5,0,13" TextWrapping="Wrap"/>
                                <Button x:Name="EngineButton" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Stretch" Padding="12,10"
                                        AutomationProperties.Name="Запустить или остановить">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <a:Ico Glyph="&#xE768;" Size="14" x:Name="EngineButtonIcon" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="EngineButtonText" Text="Запустить" Margin="9,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="12,0">
                            <TextBlock Text="МЕНЮ" Style="{StaticResource Label}" Margin="16,0,0,8"/>
                            <RadioButton x:Name="NavAccounts" Style="{StaticResource Nav}" Tag="&#xE716;" Content="Аккаунты" IsChecked="True" GroupName="Nav"/>
                            <RadioButton x:Name="NavTop" Style="{StaticResource Nav}" Tag="&#xE734;" Content="Топ АФК" GroupName="Nav"/>
                            <RadioButton x:Name="NavSchedule" Style="{StaticResource Nav}" Tag="&#xE787;" Content="Расписание" GroupName="Nav"/>
                            <RadioButton x:Name="NavMacros" Style="{StaticResource Nav}" Tag="bolt" Content="Макросы" GroupName="Nav"/>
                            <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Настройки" GroupName="Nav"/>
                            <RadioButton x:Name="NavLog" Style="{StaticResource Nav}" Tag="&#xE8A5;" Content="Журнал" GroupName="Nav"/>
                            <RadioButton x:Name="NavHelp" Style="{StaticResource Nav}" Tag="&#xE946;" Content="Помощь" GroupName="Nav"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
                </Grid>

                <!-- ===== Содержимое ===== -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="MinButton" Style="{StaticResource ChromeBtn}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Свернуть"/>
                        <Button x:Name="MaxButton" Style="{StaticResource ChromeBtn}" Content="&#xE922;" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="CloseButton" Style="{StaticResource ChromeClose}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="В трей"/>
                    </StackPanel>

                    <!-- Плашка: перезагрузка, предупреждения -->
                    <Border x:Name="Banner" Grid.Row="1" Visibility="Collapsed" Margin="34,0,34,14" CornerRadius="14" Padding="16,12"
                            Background="#2A2108" BorderBrush="#5C4710" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <a:Ico Glyph="&#xE7BA;" Size="19" x:Name="BannerIcon" Foreground="{StaticResource Yellow}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BannerText" Grid.Column="1" Margin="12,0" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BannerAction" Style="{StaticResource Btn}" Padding="12,6" Visibility="Collapsed"/>
                                <Button x:Name="BannerClose" Style="{StaticResource IconBtn}" Content="&#xE8BB;" FontSize="10" Margin="6,0,0,0" ToolTip="Скрыть"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <!-- ===== Аккаунты ===== -->
                        <Grid x:Name="PageAccounts" Margin="34,0,34,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Аккаунты" Style="{StaticResource H1}"/>
                                    <TextBlock x:Name="AccountsSub" Text="" Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="RejoinAllButton" Style="{StaticResource Btn}">
                                        <StackPanel Orientation="Horizontal">
                                            <a:Ico Glyph="&#xE72C;" Size="15"/>
                                            <TextBlock Text="Перезайти всеми" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AddAccountButton" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <a:Ico Glyph="&#xE710;" Size="15"/>
                                            <TextBlock Text="Добавить" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="-6,22,-6,18">
                                <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="2" Height="2" VerticalAlignment="Top" Visibility="{StaticResource FxVisibility}" Margin="-16,-14,-16,0" CornerRadius="14,14,0,0">
                                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00C084FC" Offset="0"/><GradientStop Color="#C084FC" Offset="0.5"/><GradientStop Color="#00C084FC" Offset="1"/></LinearGradientBrush></Border.Background>
                                            <Border.Effect><DropShadowEffect Color="#C084FC" BlurRadius="14" ShadowDepth="0" Opacity="{StaticResource FxOpacity}"/></Border.Effect>
                                        </Border>
                                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource StatTileBg}" BorderBrush="{StaticResource StatTileBorder}" BorderThickness="1" VerticalAlignment="Top">
                                            <a:Ico Glyph="&#xE7FC;" Size="20" Foreground="{StaticResource AccentText}" HorizontalAlignment="Center">
                                                <a:Ico.Effect><DropShadowEffect Color="#C084FC" BlurRadius="12" ShadowDepth="0" Opacity="{StaticResource FxOpacity}"/></a:Ico.Effect>
                                            </a:Ico>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="В игре" Foreground="{StaticResource LabelBrush}" FontFamily="{StaticResource Display}" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="StatGameValue" Text="—" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="StatGameSub" Text="" Foreground="{StaticResource Text3}" FontSize="11.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="2" Height="2" VerticalAlignment="Top" Visibility="{StaticResource FxVisibility}" Margin="-16,-14,-16,0" CornerRadius="14,14,0,0">
                                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#0022D3EE" Offset="0"/><GradientStop Color="#22D3EE" Offset="0.5"/><GradientStop Color="#0022D3EE" Offset="1"/></LinearGradientBrush></Border.Background>
                                            <Border.Effect><DropShadowEffect Color="#22D3EE" BlurRadius="14" ShadowDepth="0" Opacity="{StaticResource FxOpacity}"/></Border.Effect>
                                        </Border>
                                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource StatTileBg}" BorderBrush="{StaticResource StatTileBorder}" BorderThickness="1" VerticalAlignment="Top">
                                            <a:Ico Glyph="&#xE9D9;" Size="20" Foreground="#22D3EE" HorizontalAlignment="Center">
                                                <a:Ico.Effect><DropShadowEffect Color="#22D3EE" BlurRadius="12" ShadowDepth="0" Opacity="{StaticResource FxOpacity}"/></a:Ico.Effect>
                                            </a:Ico>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="Память" Foreground="{StaticResource LabelBrush}" FontFamily="{StaticResource Display}" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="StatMemValue" Text="—" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="StatMemSub" Text="" Foreground="{StaticResource Text3}" FontSize="11.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}" Margin="6,0" Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="2" Height="2" VerticalAlignment="Top" Visibility="{StaticResource FxVisibility}" Margin="-16,-14,-16,0" CornerRadius="14,14,0,0">
                                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#002EF2A6" Offset="0"/><GradientStop Color="#2EF2A6" Offset="0.5"/><GradientStop Color="#002EF2A6" Offset="1"/></LinearGradientBrush></Border.Background>
                                            <Border.Effect><DropShadowEffect Color="#2EF2A6" BlurRadius="14" ShadowDepth="0" Opacity="{StaticResource FxOpacity}"/></Border.Effect>
                                        </Border>
                                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource StatTileBg}" BorderBrush="{StaticResource StatTileBorder}" BorderThickness="1" VerticalAlignment="Top">
                                            <a:Ico Glyph="&#xE943;" Size="20" Foreground="#2EF2A6" HorizontalAlignment="Center">
                                                <a:Ico.Effect><DropShadowEffect Color="#2EF2A6" BlurRadius="12" ShadowDepth="0" Opacity="{StaticResource FxOpacity}"/></a:Ico.Effect>
                                            </a:Ico>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock x:Name="StatPotLabel" Text="Потассиум" Foreground="{StaticResource LabelBrush}" FontFamily="{StaticResource Display}" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="StatPotValue" Text="—" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="StatPotSub" Text="" Foreground="{StaticResource Text3}" FontSize="11.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border x:Name="StatSchedCard" Style="{StaticResource Card}" Margin="6,0" Padding="16,14" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="2" Height="2" VerticalAlignment="Top" Visibility="{StaticResource FxVisibility}" Margin="-16,-14,-16,0" CornerRadius="14,14,0,0">
                                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#00FFD23F" Offset="0"/><GradientStop Color="#FFD23F" Offset="0.5"/><GradientStop Color="#00FFD23F" Offset="1"/></LinearGradientBrush></Border.Background>
                                            <Border.Effect><DropShadowEffect Color="#FFD23F" BlurRadius="14" ShadowDepth="0" Opacity="{StaticResource FxOpacity}"/></Border.Effect>
                                        </Border>
                                        <Border Width="42" Height="42" CornerRadius="12" Background="{StaticResource StatTileBg}" BorderBrush="{StaticResource StatTileBorder}" BorderThickness="1" VerticalAlignment="Top">
                                            <a:Ico Glyph="&#xE787;" Size="20" Foreground="#FFD23F" HorizontalAlignment="Center">
                                                <a:Ico.Effect><DropShadowEffect Color="#FFD23F" BlurRadius="12" ShadowDepth="0" Opacity="{StaticResource FxOpacity}"/></a:Ico.Effect>
                                            </a:Ico>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="Расписание" Foreground="{StaticResource LabelBrush}" FontFamily="{StaticResource Display}" FontSize="12.5" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="StatSchedValue" Text="—" FontFamily="{StaticResource Display}" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="StatSchedSub" Text="" Foreground="{StaticResource Text3}" FontSize="11.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
                                <StackPanel Margin="0,0,0,24">
                                    <ItemsControl x:Name="AccountsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,10" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                                    <Grid.RenderTransform>
                                                        <TranslateTransform x:Name="CardMove" X="-26"/>
                                                    </Grid.RenderTransform>
                                                    <Grid.Triggers>
                                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.35"/>
                                                                    <DoubleAnimation Storyboard.TargetName="CardMove" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.5" EasingFunction="{StaticResource EaseOut}"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <EventTrigger RoutedEvent="UIElement.MouseEnter">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <EventTrigger RoutedEvent="UIElement.MouseLeave">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetName="HoverRing" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </Grid.Triggers>
                                                    <Border Background="{StaticResource CardGradient}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14"/>
                                                    <!-- неоновая полоска состояния слева -->
                                                    <Border Width="3" HorizontalAlignment="Left" Margin="0,12" CornerRadius="2" Background="{Binding StateBrush}">
                                                        <Border.Effect><DropShadowEffect Color="{Binding StateBrush.Color}" BlurRadius="12" ShadowDepth="0" Opacity="{StaticResource FxOpacity}"/></Border.Effect>
                                                    </Border>
                                                    <Border x:Name="HoverRing" BorderBrush="{StaticResource HoverRingBrush}" BorderThickness="1" CornerRadius="14" Opacity="0" IsHitTestVisible="False" Effect="{StaticResource GlowSoft}" Background="{StaticResource HoverRingBg}">
                                                    </Border>
                                                    <Grid Margin="16,12" Opacity="{Binding RowOpacity}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Grid Width="44" Height="44">
                                                            <Ellipse Fill="{Binding AvatarBack}"/>
                                                            <TextBlock Text="{Binding Initials}" FontSize="15" FontWeight="Bold" Foreground="#0E0B1A"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            <Ellipse>
                                                                <Ellipse.Fill>
                                                                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                            <Ellipse Stroke="{Binding StateBrush}" StrokeThickness="1.5" Opacity="0.85">
                                                                <Ellipse.Effect><DropShadowEffect Color="{Binding StateBrush.Color}" BlurRadius="10" ShadowDepth="0" Opacity="{StaticResource FxOpacity}"/></Ellipse.Effect>
                                                            </Ellipse>
                                                            <Ellipse Width="13" Height="13" Fill="{Binding StateBrush}" Stroke="{StaticResource CardBg}" StrokeThickness="2.5"
                                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"/>
                                                        </Grid>

                                                        <StackPanel Grid.Column="1" Margin="14,0,14,0" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontSize="16" FontWeight="SemiBold"/>
                                                                <Border Visibility="{Binding MainVisibility}" Background="{StaticResource BrandGradient}" CornerRadius="6"
                                                                        Padding="7,1,7,2" Margin="9,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="МЕЙН" Foreground="{StaticResource OnBrand}" FontFamily="{StaticResource Display}" FontSize="10.5" FontWeight="SemiBold"/>
                                                                </Border>
                                                                <Border Visibility="{Binding OwnLinkVisibility}" Background="#062A33" CornerRadius="6"
                                                                        Padding="7,1,7,2" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Своя ссылка на сервер">
                                                                    <TextBlock Text="СВОЙ СЕРВЕР" Foreground="{StaticResource Blue}" FontSize="9.5" FontWeight="Bold"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Text3}" FontSize="12" Margin="0,3,0,0"
                                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailTip}"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" Visibility="{Binding MetricsVisibility}" ToolTip="В игре">
                                                                <a:Ico Glyph="&#xE823;" Size="14" Foreground="{StaticResource Text3}"/>
                                                                <TextBlock Text="{Binding Uptime}" Foreground="{StaticResource Text2}" Margin="6,0,0,0" FontSize="12"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" Visibility="{Binding MetricsVisibility}" ToolTip="{Binding MemoryTip}">
                                                                <a:Ico Glyph="&#xE9D9;" Size="14" Foreground="{StaticResource Text3}"/>
                                                                <TextBlock Text="{Binding Memory}" Foreground="{StaticResource Text2}" Margin="6,0,0,0" FontSize="12"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,4,0" ToolTip="Перезаходов">
                                                                <a:Ico Glyph="&#xE72C;" Size="14" Foreground="{StaticResource Text3}"/>
                                                                <TextBlock Text="{Binding Restarts}" Foreground="{StaticResource Text2}" Margin="6,0,0,0" FontSize="12"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <Border Grid.Column="3" Background="{Binding StateBack}" BorderBrush="{Binding StateBrush}" BorderThickness="1" CornerRadius="14" Padding="11,5" Margin="12,0,10,0"
                                                                VerticalAlignment="Center" MinWidth="100">
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" VerticalAlignment="Center">
                                                                    <Ellipse.Effect><DropShadowEffect Color="{Binding StateBrush.Color}" BlurRadius="8" ShadowDepth="0" Opacity="{StaticResource FxOpacity}"/></Ellipse.Effect>
                                                                </Ellipse>
                                                                <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" Margin="7,0,0,0"
                                                                           FontFamily="{StaticResource Display}" FontWeight="SemiBold" FontSize="12.5"/>
                                                            </StackPanel>
                                                        </Border>

                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Style="{StaticResource IconBtn}" Tag="rejoin" Content="&#xE72C;" ToolTip="Перезайти"
                                                                    AutomationProperties.Name="{Binding Name, StringFormat='Перезайти {0}'}"/>
                                                            <Button Style="{StaticResource IconBtn}" Tag="edit" Content="&#xE70F;" ToolTip="Изменить"
                                                                    AutomationProperties.Name="{Binding Name, StringFormat='Изменить {0}'}"/>
                                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="8,0,2,0"
                                                                      ToolTip="Держать в игре"
                                                                      AutomationProperties.Name="{Binding Name, StringFormat='Включён {0}'}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border x:Name="AccountsEmpty" Visibility="Collapsed" Style="{StaticResource Card}" Padding="30,40">
                                        <StackPanel HorizontalAlignment="Center">
                                            <Border Width="62" Height="62" CornerRadius="18" Background="{StaticResource BrandGradient}" HorizontalAlignment="Center">
                                                <a:Ico Glyph="&#xE716;" Size="30" Foreground="{StaticResource OnBrand}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="Аккаунтов пока нет" Style="{StaticResource H2}" FontSize="17" HorizontalAlignment="Center" Margin="0,18,0,0"/>
                                            <TextBlock Text="Добавь по логину и паролю или по куке." Style="{StaticResource Sub}" TextAlignment="Center" Margin="0,6,0,20"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button x:Name="EmptyImportButton" Style="{StaticResource Btn}" Content="Импорт accounts.txt"/>
                                                <Button x:Name="EmptyAddButton" Style="{StaticResource BtnPrimary}" Content="Добавить аккаунт" Margin="10,0,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- ===== Топ АФК (строки собирает TopPage.cs) ===== -->
                        <ScrollViewer x:Name="PageTop" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="34,0,34,28" MaxWidth="860" HorizontalAlignment="Left">
                                <TextBlock Text="Топ АФК" Style="{StaticResource H1}"/>
                                <TextBlock Text="Кто дольше всех простоял в АФК за месяц." Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                                <StackPanel x:Name="TopHost" Margin="0,22,0,0" MinWidth="640"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ===== Макросы OverFlux (карточки собирает MacrosPage.cs) ===== -->
                        <ScrollViewer x:Name="PageMacros" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="34,0,34,28" MaxWidth="860" HorizontalAlignment="Left">
                                <TextBlock Text="Макросы" Style="{StaticResource H1}"/>
                                <TextBlock Text="Из OverFlux: Star Saw, Jelly Beans, Auto Clicker и Saw + Beans. Жмут в активное окно Роблокса." Style="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                <StackPanel x:Name="MacrosHost" Margin="0,22,0,0" MinWidth="640"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ===== Расписание ===== -->
                        <ScrollViewer x:Name="PageSchedule" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="34,0,34,28" MaxWidth="860" HorizontalAlignment="Left">
                                <TextBlock Text="Расписание" Style="{StaticResource H1}"/>
                                <TextBlock Text="Раз в день: перезагрузка ПК или перезаход всеми." Style="{StaticResource Sub}" Margin="0,4,0,0"/>

                                <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="24,20">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel Margin="0,0,24,0">
                                                <TextBlock Text="Плановый перезапуск" Style="{StaticResource H2}"/>
                                                <TextBlock Text="Каждый день в одно время" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <CheckBox x:Name="ScheduleSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                                        </Grid>

                                        <StackPanel x:Name="ScheduleBody" Margin="0,4,0,0">
                                            <Border Height="1" Background="{StaticResource Line}" Margin="0,18"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="ВРЕМЯ" Style="{StaticResource Label}"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <Button x:Name="HourUp" Style="{StaticResource IconBtn}" Content="&#xE70E;" Width="64" Height="20" FontSize="9"/>
                                                            <TextBox x:Name="HourBox" Style="{StaticResource Field}" Width="64" FontSize="24" FontWeight="Bold"
                                                                     TextAlignment="Center" Padding="4,6" MaxLength="2"/>
                                                            <Button x:Name="HourDown" Style="{StaticResource IconBtn}" Content="&#xE70D;" Width="64" Height="20" FontSize="9"/>
                                                        </StackPanel>
                                                        <TextBlock Text=":" FontSize="26" FontWeight="Bold" VerticalAlignment="Center" Margin="8,0,8,4"
                                                                   Foreground="{StaticResource AccentText}"/>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <Button x:Name="MinuteUp" Style="{StaticResource IconBtn}" Content="&#xE70E;" Width="64" Height="20" FontSize="9"/>
                                                            <TextBox x:Name="MinuteBox" Style="{StaticResource Field}" Width="64" FontSize="24" FontWeight="Bold"
                                                                     TextAlignment="Center" Padding="4,6" MaxLength="2"/>
                                                            <Button x:Name="MinuteDown" Style="{StaticResource IconBtn}" Content="&#xE70D;" Width="64" Height="20" FontSize="9"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                    <TextBlock Text="ЧАСОВОЙ ПОЯС" Style="{StaticResource Label}"/>
                                                    <ComboBox x:Name="ZoneBox" Style="{StaticResource Combo}" Height="44" Margin="0,22,0,0"/>
                                                    <TextBlock x:Name="ZoneHint" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="ДЕЙСТВИЕ" Style="{StaticResource Label}" Margin="0,24,0,8"/>
                                            <UniformGrid Columns="2" Margin="-6,0">
                                                <RadioButton x:Name="ActionReboot" Style="{StaticResource RadioCard}" Tag="&#xE7E8;" Margin="6,0" GroupName="ScheduleAction">
                                                    <StackPanel>
                                                        <TextBlock Text="Перезагрузить ПК" FontWeight="Bold" FontSize="14"/>
                                                        <TextBlock Text="После загрузки AutoRejoin зайдёт сам, мейн первым." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton x:Name="ActionRejoin" Style="{StaticResource RadioCard}" Tag="&#xE72C;" Margin="6,0" GroupName="ScheduleAction">
                                                    <StackPanel>
                                                        <TextBlock Text="Перезайти всеми" FontWeight="Bold" FontSize="14"/>
                                                        <TextBlock Text="Окна закроются и зайдут заново по одному." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </RadioButton>
                                            </UniformGrid>

                                            <Border Background="{StaticResource FieldBg}" CornerRadius="14" Padding="16,14" Margin="0,22,0,0"
                                                    BorderBrush="{StaticResource Line}" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource BrandGradient}">
                                                        <a:Ico Glyph="&#xE823;" Size="20" Foreground="{StaticResource OnBrand}" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                                        <TextBlock x:Name="ScheduleNext" FontSize="14.5" FontWeight="Bold"/>
                                                        <TextBlock x:Name="ScheduleNextSub" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <Button x:Name="ScheduleRunNow" Grid.Column="2" Style="{StaticResource Btn}" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <a:Ico Glyph="&#xE768;" Size="13"/>
                                                            <TextBlock Text="Сейчас" Margin="8,0,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ScheduleWarn" Visibility="Collapsed" Margin="0,14,0,0" CornerRadius="14" Padding="16,12"
                                        Background="#2A2108" BorderBrush="#5C4710" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <a:Ico Glyph="&#xE7BA;" Size="19" Foreground="{StaticResource Yellow}"/>
                                        <TextBlock x:Name="ScheduleWarnText" Grid.Column="1" Margin="12,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                        <Button x:Name="ScheduleWarnFix" Grid.Column="2" Style="{StaticResource Btn}" Padding="12,6" Content="Включить автозапуск"/>
                                    </Grid>
                                </Border>

                                <TextBlock Style="{StaticResource Hint}" Margin="4,14,0,0"
                                           Text="Для перезагрузки нужен автозапуск (Настройки → Запуск) и вход в Windows без пароля."/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ===== Настройки (строки собирает SettingsPage.cs) ===== -->
                        <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="34,0,34,28" MaxWidth="900" HorizontalAlignment="Left">
                                <TextBlock Text="Настройки" Style="{StaticResource H1}"/>
                                <TextBlock Text="Применяются сразу." Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                                <StackPanel x:Name="SettingsHost" Margin="0,22,0,0"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- ===== Журнал ===== -->
                        <Grid x:Name="PageLog" Visibility="Collapsed" Margin="34,0,34,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Журнал" Style="{StaticResource H1}"/>
                                    <TextBlock Text="Что и почему происходило." Style="{StaticResource Sub}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBox x:Name="LogFilter" Style="{StaticResource Combo}" Width="210" Height="38"/>
                                    <Button x:Name="LogCopy" Style="{StaticResource IconBtn}" Content="&#xE8C8;" Margin="10,0,0,0" ToolTip="Скопировать"/>
                                    <Button x:Name="LogOpen" Style="{StaticResource IconBtn}" Content="&#xE838;" ToolTip="Открыть rejoin.log"/>
                                    <Button x:Name="LogClear" Style="{StaticResource IconBtn}" Content="&#xE74D;" ToolTip="Очистить экран"/>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,10" Margin="0,20,0,0">
                                <ListBox x:Name="LogList" Style="{StaticResource PlainList}" FontSize="12.5">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="66"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}" Foreground="{StaticResource Text3}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Account}" Foreground="{StaticResource AccentText}" FontWeight="SemiBold" Margin="0,0,8,0"
                                                           Visibility="{Binding AccountVisibility}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{Binding Brush}" TextWrapping="Wrap"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>

                        <!-- ===== Помощь ===== -->
                        <ScrollViewer x:Name="PageHelp" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="34,0,34,28" MaxWidth="860" HorizontalAlignment="Left">
                                <TextBlock Text="Помощь" Style="{StaticResource H1}"/>
                                <TextBlock Text="Коротко о главном." Style="{StaticResource Sub}" Margin="0,4,0,0"/>

                                <!-- владелец -->
                                <Border Margin="0,22,0,0" CornerRadius="16" Padding="22,18" BorderBrush="{StaticResource OwnerCardBorder}" Background="{StaticResource OwnerCardBg}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="52" Height="52">
                                            <Ellipse Fill="{StaticResource BrandGradient}"/>
                                            <TextBlock Text="C" FontWeight="Bold" FontSize="22" Foreground="{StaticResource OnBrand}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                                            <TextBlock Text="ВЛАДЕЛЕЦ И РАЗРАБОТЧИК" Foreground="{StaticResource Text3}" FontSize="10" FontWeight="Bold"/>
                                            <TextBlock Text="clxwnlesss" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrandText}" Margin="0,2,0,0"/>
                                            <TextBlock Text="Вопросы, баги, идеи — пиши в Discord." Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="HelpContact" Grid.Column="2" Style="{StaticResource BtnDiscord}" Padding="16,10" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <a:Ico Glyph="&#xE8BD;" Size="16"/>
                                                <TextBlock Text="Связь в Discord" Margin="9,0,0,0"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Как начать" Style="{StaticResource H2}"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Foreground="{StaticResource Text2}">
                                            <Run Text="1. Аккаунты → «Добавить» (логин и пароль или кука)."/>
                                            <LineBreak/>
                                            <Run Text="2. Настройки → «Ссылка на сервер» (пусто — обычный BSS)."/>
                                            <LineBreak/>
                                            <Run Text="3. «Запустить» слева. Крестик — сворачивает в трей."/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Кука .ROBLOSECURITY" Style="{StaticResource H2}"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Foreground="{StaticResource Text2}"
                                                   Text="roblox.com → F12 → Application → Cookies → .ROBLOSECURITY → скопируй значение. Не жми потом «Выйти» в этом браузере."/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Если что-то не так" Style="{StaticResource H2}"/>
                                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Foreground="{StaticResource Text2}">
                                            <Run Text="• 401 — кука устарела: вставь новую или войди по логину и паролю."/>
                                            <LineBreak/>
                                            <Run Text="• 403 — предупреждение Роблокса: прими его или включи автопринятие."/>
                                            <LineBreak/>
                                            <Run Text="• «Ждёт памяти» — увеличь файл подкачки (Настройки → Память)."/>
                                            <LineBreak/>
                                            <Run Text="• Окна не запускаются — помогает только перезагрузка."/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                    <Grid>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="Безопасность" Style="{StaticResource H2}"/>
                                            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                                                       Text="Куки и пароли зашифрованы под твою учётку Windows. Папку данных никому не отправляй."/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button x:Name="HelpOpenData" Style="{StaticResource Btn}" Content="Данные"/>
                                            <Button x:Name="HelpOpenApp" Style="{StaticResource Btn}" Content="Программа" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="AutoRejoin · © clxwnlesss" Foreground="{StaticResource Text3}" FontSize="11.5" Margin="4,18,0,0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
