<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoRejoin" Width="1120" Height="740" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="{StaticResource Bg}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Боковая панель -->
            <Border Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="22,20,16,26">
                        <Border Width="38" Height="38" CornerRadius="11" Background="{StaticResource AccentGradient}">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="AutoRejoin" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="VersionText" Text="Version 1.2" Foreground="{StaticResource Text3}" FontSize="11.5" Margin="0,1,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Состояние движка и кнопка запуска -->
                    <Border DockPanel.Dock="Bottom" Margin="14,0,14,16" Padding="16,14" CornerRadius="13"
                            Background="{StaticResource CardBg}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="10" Height="10" VerticalAlignment="Center">
                                    <Ellipse x:Name="EngineGlow" Width="10" Height="10" Fill="#697088" Opacity="0.35"/>
                                    <Ellipse x:Name="EngineDot" Width="6" Height="6" Fill="#697088"/>
                                </Grid>
                                <TextBlock x:Name="EngineTitle" Text="Остановлен" Margin="9,0,0,0" FontWeight="SemiBold" FontSize="13.5"/>
                            </StackPanel>
                            <TextBlock x:Name="EngineSub" Text="Нажми «Запустить»" Foreground="{StaticResource Text2}" FontSize="12"
                                       Margin="0,5,0,13" TextWrapping="Wrap"/>
                            <Button x:Name="EngineButton" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Stretch" Padding="12,9"
                                    AutomationProperties.Name="Запустить или остановить">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock x:Name="EngineButtonIcon" Text="&#xE768;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="EngineButtonText" Text="Запустить" Margin="9,0,0,0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="12,0">
                        <RadioButton x:Name="NavAccounts" Style="{StaticResource Nav}" Tag="&#xE716;" Content="Аккаунты" IsChecked="True" GroupName="Nav"/>
                        <RadioButton x:Name="NavSchedule" Style="{StaticResource Nav}" Tag="&#xE787;" Content="Расписание" GroupName="Nav"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource Nav}" Tag="&#xE713;" Content="Настройки" GroupName="Nav"/>
                        <RadioButton x:Name="NavLog" Style="{StaticResource Nav}" Tag="&#xE8A5;" Content="Журнал" GroupName="Nav"/>
                        <RadioButton x:Name="NavHelp" Style="{StaticResource Nav}" Tag="&#xE946;" Content="Помощь" GroupName="Nav"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Содержимое -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="MinButton" Style="{StaticResource ChromeBtn}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Свернуть"/>
                    <Button x:Name="MaxButton" Style="{StaticResource ChromeBtn}" Content="&#xE922;" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button x:Name="CloseButton" Style="{StaticResource ChromeClose}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Свернуть в трей"/>
                </StackPanel>

                <!-- Плашка: перезагрузка, предупреждения движка -->
                <Border x:Name="Banner" Grid.Row="1" Visibility="Collapsed" Margin="32,0,32,14" CornerRadius="12" Padding="16,12"
                        Background="#211B0E" BorderBrush="#4A3812" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="BannerIcon" Text="&#xE7BA;" FontFamily="{StaticResource Icons}" FontSize="16"
                                   Foreground="{StaticResource Yellow}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BannerText" Grid.Column="1" Margin="12,0" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BannerAction" Style="{StaticResource Btn}" Padding="12,6" Visibility="Collapsed"/>
                            <Button x:Name="BannerClose" Style="{StaticResource IconBtn}" Content="&#xE8BB;" FontSize="10" Margin="6,0,0,0" ToolTip="Скрыть"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <!-- ===== Аккаунты ===== -->
                    <Grid x:Name="PageAccounts" Margin="32,0,32,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Аккаунты" Style="{StaticResource H1}"/>
                                <TextBlock x:Name="AccountsSub" Text="Держит все аккаунты в игре и перезаходит, если что-то случилось." Style="{StaticResource Sub}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button x:Name="RejoinAllButton" Style="{StaticResource Btn}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="12.5"/>
                                        <TextBlock Text="Перезайти всеми" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="AddAccountButton" Style="{StaticResource BtnPrimary}" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE710;" Style="{StaticResource Glyph}" FontSize="12.5"/>
                                        <TextBlock Text="Добавить аккаунт" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <UniformGrid Grid.Row="1" Rows="1" Columns="4" Margin="-6,22,-6,18">
                            <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,15">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="В игре" Foreground="{StaticResource Text3}" FontSize="12"/>
                                        <TextBlock x:Name="StatGameValue" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="StatGameSub" Text="" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Text="&#xE7FC;" Style="{StaticResource Glyph}" FontSize="16" Foreground="{StaticResource Accent}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,15">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Свободная память" Foreground="{StaticResource Text3}" FontSize="12"/>
                                        <TextBlock x:Name="StatMemValue" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0"/>
                                        <TextBlock x:Name="StatMemSub" Text="" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="16" Foreground="{StaticResource Accent}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}" Margin="6,0" Padding="18,15">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Потассиум" Foreground="{StaticResource Text3}" FontSize="12"/>
                                        <TextBlock x:Name="StatPotValue" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="StatPotSub" Text="" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Text="&#xE943;" Style="{StaticResource Glyph}" FontSize="16" Foreground="{StaticResource Accent}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                            <Border x:Name="StatSchedCard" Style="{StaticResource Card}" Margin="6,0" Padding="18,15" Cursor="Hand">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock Text="Плановый перезапуск" Foreground="{StaticResource Text3}" FontSize="12"/>
                                        <TextBlock x:Name="StatSchedValue" Text="—" FontSize="22" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="StatSchedSub" Text="" Foreground="{StaticResource Text2}" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Text="&#xE787;" Style="{StaticResource Glyph}" FontSize="16" Foreground="{StaticResource Accent}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                        </UniformGrid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
                            <StackPanel Margin="0,0,0,24">
                                <ItemsControl x:Name="AccountsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                                    CornerRadius="14" Padding="16,13" Margin="0,0,0,10" Opacity="{Binding RowOpacity}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Grid Width="46" Height="46">
                                                        <Ellipse Fill="{Binding AvatarBack}"/>
                                                        <TextBlock Text="{Binding Initials}" FontSize="15" FontWeight="Bold" Foreground="#14161D"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <Ellipse>
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                        <Ellipse Width="13" Height="13" Fill="{Binding StateBrush}" Stroke="{StaticResource CardBg}" StrokeThickness="2.5"
                                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-1,-1"/>
                                                    </Grid>

                                                    <StackPanel Grid.Column="1" Margin="15,0,14,0" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/>
                                                            <Border Visibility="{Binding MainVisibility}" Background="{StaticResource AccentSoft}" CornerRadius="5"
                                                                    Padding="6,1,6,2" Margin="9,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="МЕЙН" Foreground="{StaticResource Accent}" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                            <Border Visibility="{Binding OwnLinkVisibility}" Background="#1D2433" CornerRadius="5"
                                                                    Padding="6,1,6,2" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="У аккаунта своя ссылка на сервер">
                                                                <TextBlock Text="СВОЙ СЕРВЕР" Foreground="{StaticResource Blue}" FontSize="10" FontWeight="Bold"/>
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Detail}" Foreground="{StaticResource Text2}" FontSize="12.5" Margin="0,4,0,0"
                                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding DetailTip}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0" Visibility="{Binding MetricsVisibility}" ToolTip="Окно работает">
                                                            <TextBlock Text="&#xE823;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource Text3}"/>
                                                            <TextBlock Text="{Binding Uptime}" Foreground="{StaticResource Text2}" Margin="6,0,0,0" FontSize="12.5"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,16,0" Visibility="{Binding MetricsVisibility}" ToolTip="{Binding MemoryTip}">
                                                            <TextBlock Text="&#xE9D9;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource Text3}"/>
                                                            <TextBlock Text="{Binding Memory}" Foreground="{StaticResource Text2}" Margin="6,0,0,0" FontSize="12.5"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,6,0" ToolTip="Перезаходов с запуска">
                                                            <TextBlock Text="&#xE72C;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{StaticResource Text3}"/>
                                                            <TextBlock Text="{Binding Restarts}" Foreground="{StaticResource Text2}" Margin="6,0,0,0" FontSize="12.5"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Border Grid.Column="3" Background="{Binding StateBack}" CornerRadius="13" Padding="11,5" Margin="12,0,10,0"
                                                            VerticalAlignment="Center" MinWidth="104">
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding StateText}" Foreground="{Binding StateBrush}" Margin="7,0,0,0"
                                                                       FontWeight="SemiBold" FontSize="12"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource IconBtn}" Tag="rejoin" Content="&#xE72C;" ToolTip="Перезайти этим аккаунтом"
                                                                AutomationProperties.Name="{Binding Name, StringFormat='Перезайти {0}'}"/>
                                                        <Button Style="{StaticResource IconBtn}" Tag="edit" Content="&#xE70F;" ToolTip="Изменить"
                                                                AutomationProperties.Name="{Binding Name, StringFormat='Изменить {0}'}"/>
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=TwoWay}" Margin="8,0,2,0"
                                                                  ToolTip="Включён: AutoRejoin держит этот аккаунт в игре"
                                                                  AutomationProperties.Name="{Binding Name, StringFormat='Включён {0}'}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border x:Name="AccountsEmpty" Visibility="Collapsed" Style="{StaticResource Card}" Padding="30,36">
                                    <StackPanel HorizontalAlignment="Center">
                                        <Border Width="58" Height="58" CornerRadius="16" Background="{StaticResource AccentSoft}" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE716;" Style="{StaticResource Glyph}" FontSize="24" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Пока ни одного аккаунта" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                        <TextBlock Text="Добавь аккаунт — по логину и паролю или по куке .ROBLOSECURITY. AutoRejoin будет держать его в игре и перезаходить сам."
                                                   Style="{StaticResource Sub}" TextAlignment="Center" MaxWidth="420" Margin="0,6,0,18"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button x:Name="EmptyImportButton" Style="{StaticResource Btn}" Content="Импорт из accounts.txt"/>
                                            <Button x:Name="EmptyAddButton" Style="{StaticResource BtnPrimary}" Content="Добавить аккаунт" Margin="10,0,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Расписание ===== -->
                    <ScrollViewer x:Name="PageSchedule" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,0,32,28" MaxWidth="860" HorizontalAlignment="Left">
                            <TextBlock Text="Расписание" Style="{StaticResource H1}"/>
                            <TextBlock Text="Раз в день в заданное время — перезагрузка компьютера или перезаход всеми аккаунтами. Сбрасывает раздувшиеся окна, зависший сервер и Роблокс, который перестал запускать окна."
                                       Style="{StaticResource Sub}" Margin="0,5,0,0"/>

                            <Border Style="{StaticResource Card}" Margin="0,22,0,0" Padding="24,20">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Margin="0,0,24,0">
                                            <TextBlock Text="Плановый перезапуск" Style="{StaticResource H2}"/>
                                            <TextBlock Text="Каждый день, в одно и то же время." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="ScheduleSwitch" Style="{StaticResource Switch}" HorizontalAlignment="Right"/>
                                    </Grid>

                                    <StackPanel x:Name="ScheduleBody" Margin="0,4,0,0">
                                        <Border Height="1" Background="{StaticResource Line}" Margin="0,18"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="ВРЕМЯ" Style="{StaticResource Label}"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Button x:Name="HourUp" Style="{StaticResource IconBtn}" Content="&#xE70E;" Width="64" Height="20" FontSize="9"/>
                                                        <TextBox x:Name="HourBox" Style="{StaticResource Field}" Width="64" FontSize="24" FontWeight="SemiBold"
                                                                 TextAlignment="Center" Padding="4,6" MaxLength="2"/>
                                                        <Button x:Name="HourDown" Style="{StaticResource IconBtn}" Content="&#xE70D;" Width="64" Height="20" FontSize="9"/>
                                                    </StackPanel>
                                                    <TextBlock Text=":" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,8,4"
                                                               Foreground="{StaticResource Text2}"/>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <Button x:Name="MinuteUp" Style="{StaticResource IconBtn}" Content="&#xE70E;" Width="64" Height="20" FontSize="9"/>
                                                        <TextBox x:Name="MinuteBox" Style="{StaticResource Field}" Width="64" FontSize="24" FontWeight="SemiBold"
                                                                 TextAlignment="Center" Padding="4,6" MaxLength="2"/>
                                                        <Button x:Name="MinuteDown" Style="{StaticResource IconBtn}" Content="&#xE70D;" Width="64" Height="20" FontSize="9"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                <TextBlock Text="ЧАСОВОЙ ПОЯС" Style="{StaticResource Label}"/>
                                                <ComboBox x:Name="ZoneBox" Style="{StaticResource Combo}" Height="44" Margin="0,22,0,0"/>
                                                <TextBlock x:Name="ZoneHint" Style="{StaticResource Hint}" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="ЧТО ДЕЛАТЬ" Style="{StaticResource Label}" Margin="0,24,0,8"/>
                                        <UniformGrid Columns="2" Margin="-6,0">
                                            <RadioButton x:Name="ActionReboot" Style="{StaticResource RadioCard}" Tag="&#xE7E8;" Margin="6,0" GroupName="ScheduleAction">
                                                <StackPanel>
                                                    <TextBlock Text="Перезагрузить компьютер" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Text="Windows перезагрузится сразу (окна Роблокса закроются). После неё AutoRejoin запустится сам: первым заведёт мейна, потом остальных."
                                                               Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="ActionRejoin" Style="{StaticResource RadioCard}" Tag="&#xE72C;" Margin="6,0" GroupName="ScheduleAction">
                                                <StackPanel>
                                                    <TextBlock Text="Перезайти всеми аккаунтами" FontWeight="SemiBold" FontSize="14"/>
                                                    <TextBlock Text="Окна всех аккаунтов закрываются разом и через 10 сек заходят заново по одному. Компьютер не перезагружается."
                                                               Style="{StaticResource Hint}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </UniformGrid>

                                        <Border Background="{StaticResource FieldBg}" CornerRadius="12" Padding="16,14" Margin="0,22,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="40" Height="40" CornerRadius="11" Background="{StaticResource AccentSoft}">
                                                    <TextBlock Text="&#xE823;" Style="{StaticResource Glyph}" FontSize="17" Foreground="{StaticResource Accent}" HorizontalAlignment="Center"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                                    <TextBlock x:Name="ScheduleNext" FontSize="14.5" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="ScheduleNextSub" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Button x:Name="ScheduleRunNow" Grid.Column="2" Style="{StaticResource Btn}" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="11"/>
                                                        <TextBlock Text="Выполнить сейчас" Margin="8,0,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ScheduleWarn" Visibility="Collapsed" Margin="0,14,0,0" CornerRadius="12" Padding="16,12"
                                    Background="#211B0E" BorderBrush="#4A3812" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource Glyph}" FontSize="16" Foreground="{StaticResource Yellow}"/>
                                    <TextBlock x:Name="ScheduleWarnText" Grid.Column="1" Margin="12,0" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                    <Button x:Name="ScheduleWarnFix" Grid.Column="2" Style="{StaticResource Btn}" Padding="12,6" Content="Включить автозапуск"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="24,18">
                                <StackPanel>
                                    <TextBlock Text="Как это работает" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0">
                                        <Run Text="• Время считается по выбранному часовому поясу — друзья в другом городе ставят свой пояс или своё время."/>
                                        <LineBreak/>
                                        <Run Text="• Срабатывает, только если AutoRejoin работал в этот момент: после перезагрузки по расписанию и если компьютер включили позже, второй раз не сработает."/>
                                        <LineBreak/>
                                        <Run Text="• Перезагрузка: нужен автозапуск AutoRejoin (Настройки → Запуск) и вход в Windows без пароля — иначе после перезагрузки аккаунты не зайдут сами."/>
                                        <LineBreak/>
                                        <Run Text="• Если Роблокс как раз перестал запускать новые окна, перезаход всеми пропускается: открытые окна не закрываются."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Настройки (строки собирает код: SettingsPage.cs) ===== -->
                    <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,0,32,28" MaxWidth="900" HorizontalAlignment="Left">
                            <TextBlock Text="Настройки" Style="{StaticResource H1}"/>
                            <TextBlock Text="Меняются сразу, перезапуск не нужен. Новое для окон (FPS, полный экран) — со следующего захода." Style="{StaticResource Sub}" Margin="0,5,0,0"/>
                            <StackPanel x:Name="SettingsHost" Margin="0,22,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Журнал ===== -->
                    <Grid x:Name="PageLog" Visibility="Collapsed" Margin="32,0,32,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Журнал" Style="{StaticResource H1}"/>
                                <TextBlock Text="Что AutoRejoin делал и почему. Полный журнал — в файле rejoin.log." Style="{StaticResource Sub}" Margin="0,5,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <ComboBox x:Name="LogFilter" Style="{StaticResource Combo}" Width="210" Height="36"/>
                                <Button x:Name="LogCopy" Style="{StaticResource IconBtn}" Content="&#xE8C8;" Margin="10,0,0,0" ToolTip="Скопировать журнал"/>
                                <Button x:Name="LogOpen" Style="{StaticResource IconBtn}" Content="&#xE838;" ToolTip="Открыть rejoin.log"/>
                                <Button x:Name="LogClear" Style="{StaticResource IconBtn}" Content="&#xE74D;" ToolTip="Очистить экран (файл не трогается)"/>
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="8,10" Margin="0,20,0,0">
                            <ListBox x:Name="LogList" Style="{StaticResource PlainList}" FontSize="12.5">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="66"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Time}" Foreground="{StaticResource Text3}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Account}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" Margin="0,0,8,0"
                                                       Visibility="{Binding AccountVisibility}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Message}" Foreground="{Binding Brush}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>

                    <!-- ===== Помощь ===== -->
                    <ScrollViewer x:Name="PageHelp" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="32,0,32,28" MaxWidth="900" HorizontalAlignment="Left">
                            <TextBlock Text="Помощь" Style="{StaticResource H1}"/>
                            <TextBlock Text="Как настроить и что делать, если что-то не так." Style="{StaticResource Sub}" Margin="0,5,0,0"/>

                            <Border Style="{StaticResource Card}" Margin="0,22,0,0">
                                <StackPanel>
                                    <TextBlock Text="Как начать" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0">
                                        <Run Text="1. Аккаунты → «Добавить аккаунт»: логин и пароль (AutoRejoin войдёт сам и сам будет обновлять куку) или кука .ROBLOSECURITY (как достать — ниже). Мейну включи «Мейн-аккаунт»."/>
                                        <LineBreak/>
                                        <Run Text="2. Настройки → «Ссылка на сервер»: VIP-ссылка или ссылка на игру. Пусто — обычный сервер Bee Swarm Simulator."/>
                                        <LineBreak/>
                                        <Run Text="3. Играешь со скриптом через Потассиум — проверь раздел «Потассиум» в настройках."/>
                                        <LineBreak/>
                                        <Run Text="4. Нажми «Запустить» слева внизу. Закроешь окно — AutoRejoin продолжит работать в трее (значок у часов)."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Как достать куку аккаунта" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0">
                                        <Run Text="1. Зайди на roblox.com под этим аккаунтом в браузере."/>
                                        <LineBreak/>
                                        <Run Text="2. F12 → вкладка Application (Приложение) → слева Cookies → https://www.roblox.com."/>
                                        <LineBreak/>
                                        <Run Text="3. Строка .ROBLOSECURITY → скопируй значение целиком (начинается с _|WARNING)."/>
                                        <LineBreak/>
                                        <Run Text="Не нажимай потом «Выйти» в этом браузере — кука перестанет работать. Для следующего аккаунта — другой браузер или режим инкогнито."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Когда окно перезаходит" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0">
                                        <Run Text="Окно закрылось или вылетело · кик, потеря связи, 20 минут бездействия · ошибка Роблокса в игре · окно зависло («Не отвечает») · не зашло на сервер за минуту · раздулось в памяти · скрипт не запустился или перестал работать (если включена проверка)."/>
                                        <LineBreak/>
                                        <Run Text="Окна заходят по одному и только когда для них хватает памяти. Если окно вылетает сразу после захода раз за разом — пауза растёт (10, 20, 40 сек … до 5 мин)."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Если что-то не так" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0">
                                        <Run Text="• «Кука устарела (401)» — при входе по логину и паролю AutoRejoin берёт новую куку сам. При входе по куке — вставь новую (кнопка ✎) или переключи аккаунт на логин и пароль."/>
                                        <LineBreak/>
                                        <Run Text="• «Не пускает (403)» — на аккаунте непринятое предупреждение Роблокса (или бан). При входе по логину и паролю откроется окно с предупреждением — прими его, дальше AutoRejoin сам. Можно включить «Принимать предупреждения Роблокса» в настройках."/>
                                        <LineBreak/>
                                        <Run Text="• «Ждёт свободной памяти» — Настройки → Память → «Настроить» файл подкачки и перезагрузи ПК (или держи меньше аккаунтов)."/>
                                        <LineBreak/>
                                        <Run Text="• «Роблокс был открыт раньше» — закрой все окна Роблокса и нажми «Остановить» → «Запустить»."/>
                                        <LineBreak/>
                                        <Run Text="• «Новые окна не запускаются» — помогает только перезагрузка (включи «Автоперезагрузку» в настройках)."/>
                                        <LineBreak/>
                                        <Run Text="• Потассиум разлогинился — войди в него или включи «Автовход» в настройках."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Безопасность" Style="{StaticResource H2}"/>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0">
                                        <Run Text="Кука и пароль — это полный доступ к аккаунту. AutoRejoin хранит куки, пароли аккаунтов и пароль Потассиума зашифрованными (Windows DPAPI) в папке данных — прочитать их можно только под твоей учётной записью Windows на этом компьютере. Сессии окна входа — там же, в папке browser."/>
                                        <LineBreak/>
                                        <Run Text="В папке с программой твоих данных нет — её можно отправлять друзьям. Папку данных (кнопка в настройках) не отправляй никому."/>
                                    </TextBlock>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                        <Button x:Name="HelpOpenData" Style="{StaticResource Btn}" Content="Открыть папку данных"/>
                                        <Button x:Name="HelpOpenApp" Style="{StaticResource Btn}" Content="Открыть папку программы" Margin="10,0,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
