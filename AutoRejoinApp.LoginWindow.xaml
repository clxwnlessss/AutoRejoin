<Window xmlns:a="clr-namespace:AutoRejoinApp;assembly=AutoRejoin" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход в Roblox" Width="980" Height="760" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <!-- Без AllowsTransparency: браузер (HwndHost) в прозрачном окне не рисуется. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" Background="{StaticResource Bg}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="64" Background="{StaticResource Sidebar}">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentGradient}">
                        <a:Ico Glyph="&#xE72E;" Size="19" Foreground="{StaticResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="Вход в Roblox" FontSize="15.5" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SubtitleText" Text="AutoRejoin входит сам и заберёт куку, когда вход завершится." Foreground="{StaticResource Text2}" FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button x:Name="MinButton" Style="{StaticResource ChromeBtn}" Content="&#xE921;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Свернуть"/>
                    <Button x:Name="CloseButton" Style="{StaticResource ChromeClose}" Content="&#xE8BB;" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Отменить вход"/>
                </StackPanel>
            </Grid>

            <Border x:Name="StatusBar" DockPanel.Dock="Top" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="20,11">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <a:Ico Glyph="&#xE895;" Size="18" x:Name="StatusIcon" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Grid.Column="1" Margin="12,0" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="13"
                               Text="Открываю страницу входа…"/>
                    <Button x:Name="CancelButton" Grid.Column="2" Style="{StaticResource Btn}" Padding="14,6" Content="Отмена"/>
                </Grid>
            </Border>

            <Border x:Name="BrowserHost" Background="#FFFFFF"/>
        </DockPanel>
    </Border>
</Window>
