<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoRejoin" Width="500" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Foreground="{StaticResource Text}" FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Border x:Name="Frame" Margin="18" Background="{StaticResource CardBg}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.6" Color="#000000"/>
        </Border.Effect>
        <StackPanel Margin="26,22,26,22">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="IconBox" Width="40" Height="40" CornerRadius="11" Background="{StaticResource AccentSoft}">
                    <TextBlock x:Name="IconText" Text="&#xE946;" FontFamily="{StaticResource Icons}" FontSize="17"
                               Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"/>
            </StackPanel>
            <TextBlock x:Name="MessageText" Style="{StaticResource Hint}" FontSize="13" LineHeight="19" Margin="0,16,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource Btn}" Content="Отмена"/>
                <Button x:Name="OkButton" Style="{StaticResource BtnPrimary}" Content="OK" Margin="10,0,0,0" MinWidth="110"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
